#include <stdio.h>
#include <stdlib.h>
#include <string.h>

/* ── Constantes del sistema simulado ───────────────────── */
#define PAGE_SIZE       4096   /* Tamaño de página: 4 KB   */
#define NUM_PAGES       16     /* Páginas lógicas por proc */
#define NUM_FRAMES      8      /* Marcos físicos totales   */
#define ADDR_BITS       16     /* Bits de dirección lógica */
#define PAGE_BITS       4      /* log2(NUM_PAGES)          */
#define OFFSET_BITS     12     /* log2(PAGE_SIZE)          */

/* ── Estructura de entrada en la tabla de páginas ────────
 * Cada entrada representa una página lógica del proceso.
 * Stallings, Fig. 8.8 | Tanenbaum, Fig. 3-11
 */
typedef struct {
    int  frame_number; /* Marco físico asignado (-1 si no está en RAM) */
    int  present;      /* 1 = en RAM, 0 = en swap / no asignada        */
    int  dirty;        /* 1 = página modificada (necesita swap-out)     */
    int  referenced;   /* 1 = accedida recientemente (para algoritmo reemplazo) */
    int  read_only;    /* 1 = solo lectura, 0 = lectura/escritura       */
} PageTableEntry;

/* ── Tabla de páginas (por proceso) ─────────────────────*/
PageTableEntry page_table[NUM_PAGES];

/* ── Mapa de marcos físicos ──────────────────────────────
 * frame_map[i] = 1 si el marco i está ocupado, 0 si libre
 */
int frame_map[NUM_FRAMES];

/* ── Estadísticas de acceso ──────────────────────────────*/
int total_accesses  = 0;
int page_faults     = 0;
int tlb_hits        = 0;  /* Simulado: si referenced==1 → "TLB hit" */

/* ── Prototipos ──────────────────────────────────────────*/
void  init_page_table(void);
int   find_free_frame(void);
void  handle_page_fault(int page_num);
long  translate_address(long logical_addr, int write_access);
void  print_page_table(void);
void  print_stats(void);

/* ════════════════════════════════════════════════════════
 * FUNCIÓN: init_page_table
 * Inicializa la tabla de páginas: todas las páginas
 * comienzan sin asignar (not present).
 * ════════════════════════════════════════════════════════*/
void init_page_table(void) {
    int i;
    for (i = 0; i < NUM_PAGES; i++) {
        page_table[i].frame_number = -1;
        page_table[i].present      =  0;
        page_table[i].dirty        =  0;
        page_table[i].referenced   =  0;
        page_table[i].read_only    =  0;
    }
    memset(frame_map, 0, sizeof(frame_map));
}

/* ════════════════════════════════════════════════════════
 * FUNCIÓN: find_free_frame
 * Busca el primer marco físico libre.
 * Retorna: índice del marco libre, o -1 si no hay ninguno.
 * ════════════════════════════════════════════════════════*/
int find_free_frame(void) {
    int i;
    for (i = 0; i < NUM_FRAMES; i++) {
        if (frame_map[i] == 0) {
            return i;
        }
    }
    return -1; /* Sin marcos libres: necesita reemplazo */
}

/* ════════════════════════════════════════════════════════
 * FUNCIÓN: handle_page_fault
 * Manejador simplificado de page fault.
 * En un SO real, esta función leería la página del disco.
 *
 * Parámetro: page_num → número de página lógica que falló.
 * ════════════════════════════════════════════════════════*/
void handle_page_fault(int page_num) {
    int frame;
    int victim;
    int i;

    page_faults++;
    printf("[PAGE FAULT] Página %d no está en RAM.\n", page_num);

    frame = find_free_frame();

    if (frame == -1) {
        /* TODO (Parte 2): Implementar un algoritmo de reemplazo de páginas.
         *
         * Pasos sugeridos:
         *   1. Recorrer la tabla de páginas en busca de la página víctima
         *      (usa el bit 'referenced' para implementar el algoritmo Clock
         *       o simplemente elige la primera página con referenced == 0).
         *   2. Si la víctima tiene dirty == 1, simula escribirla al swap
         *      (basta con imprimir un mensaje indicando el swap-out).
         *   3. Marca la entrada de la víctima como not present y libera su marco.
         *   4. Asigna ese marco a la nueva página (page_num).
         *
         * Ejemplo de mensaje de swap-out:
         *   printf("[SWAP-OUT] Página %d → disco\n", victim);
         */

        victim = -1;

        for (i = 0; i < NUM_PAGES; i++) {
            if (page_table[i].present &&
                page_table[i].referenced == 0) {
                victim = i;
                break;
            }
        }

        if (victim == -1) {
            for (i = 0; i < NUM_PAGES; i++) {
                if (page_table[i].present) {
                    page_table[i].referenced = 0;
                }
            }

            for (i = 0; i < NUM_PAGES; i++) {
                if (page_table[i].present &&
                    page_table[i].referenced == 0) {
                    victim = i;
                    break;
                }
            }
        }

        if (victim == -1) {
            printf("[ERROR] No se encontró página víctima.\n");
            exit(1);
        }

        frame = page_table[victim].frame_number;

        if (page_table[victim].dirty) {
            printf("[SWAP-OUT] Página %d → disco\n", victim);
        }

        page_table[victim].frame_number = -1;
        page_table[victim].present      = 0;
        page_table[victim].dirty        = 0;
        page_table[victim].referenced   = 0;
    }

    /* Cargar la página en el marco libre encontrado */
    frame_map[frame]                    = 1;
    page_table[page_num].frame_number   = frame;
    page_table[page_num].present        = 1;
    page_table[page_num].referenced     = 1;
    page_table[page_num].dirty          = 0;

    printf("[PAGE-IN] Página %d cargada en marco físico %d.\n", page_num, frame);
}

/* ════════════════════════════════════════════════════════
 * FUNCIÓN: translate_address
 * Traduce una dirección lógica a dirección física.
 *
 * Parámetros:
 *   logical_addr : dirección lógica de 16 bits
 *   write_access : 1 si es escritura, 0 si es lectura
 *
 * Retorna: dirección física, o -1 si hay error de protección.
 * ════════════════════════════════════════════════════════*/
long translate_address(long logical_addr, int write_access) {
    int  page_num;
    int  offset;
    long physical_addr;

    total_accesses++;

    /* TODO (Parte 1): Extraer el número de página y el desplazamiento
     * de la dirección lógica.
     *
     * Pista: usa operaciones de bits.
     *   - El número de página ocupa los PAGE_BITS más significativos.
     *   - El desplazamiento ocupa los OFFSET_BITS menos significativos.
     *
     * Fórmulas:
     *   page_num = logical_addr >> OFFSET_BITS
     *   offset   = logical_addr &  (PAGE_SIZE - 1)
     *
     * Reemplaza las líneas siguientes con tu implementación:
     */
    page_num = (int)(logical_addr >> OFFSET_BITS);
    offset   = (int)(logical_addr & (PAGE_SIZE - 1));

    printf("\n[TRADUCCION] Dir. lógica: 0x%04lX  →  Pág: %d, Offset: 0x%03X\n",
           logical_addr, page_num, offset);

    /* Verificar rango de página */
    if (page_num < 0 || page_num >= NUM_PAGES) {
        printf("[ERROR] Número de página %d fuera de rango.\n", page_num);
        return -1;
    }

    /* TODO (Parte 1b): Verificar protección de escritura.
     * Si write_access == 1 y page_table[page_num].read_only == 1,
     * imprimir un mensaje de error de protección y retornar -1.
     *
     * Mensaje sugerido:
     *   printf("[PROTECCION] Escritura denegada en página %d (solo lectura).\n", page_num);
     */

    if (write_access && page_table[page_num].read_only) {
        printf("[PROTECCION] Escritura denegada en página %d (solo lectura).\n",
               page_num);
        return -1;
    }

    /* Verificar presencia (puede generar page fault) */
    if (!page_table[page_num].present) {
        handle_page_fault(page_num);
    } else {
        /* TLB hit simulado: la página ya estaba en memoria */
        tlb_hits++;
        printf("[TLB HIT] Página %d → Marco %d\n",
               page_num, page_table[page_num].frame_number);
    }

    /* TODO (Parte 1c): Calcular la dirección física.
     *
     * Fórmula:
     *   physical_addr = (frame_number * PAGE_SIZE) + offset
     *
     * Además:
     *   - Si write_access == 1, marcar page_table[page_num].dirty = 1.
     *   - Actualizar page_table[page_num].referenced = 1.
     *   - Retornar physical_addr.
     *
     * Reemplaza el return siguiente con tu implementación:
     */
    physical_addr =
        ((long)page_table[page_num].frame_number * PAGE_SIZE) + offset;

    if (write_access) {
        page_table[page_num].dirty = 1;
    }

    page_table[page_num].referenced = 1;

    printf("[RESULTADO] Dir. física: 0x%05lX\n", physical_addr);
    return physical_addr;
}

/* ════════════════════════════════════════════════════════
 * FUNCIÓN: print_page_table
 * Imprime el estado actual de la tabla de páginas.
 * ════════════════════════════════════════════════════════*/
void print_page_table(void) {
    int i;
    printf("\n╔══════════════════════════════════════════════════╗\n");
    printf("║           TABLA DE PÁGINAS (proceso P1)          ║\n");
    printf("╠════════╦════════╦═════════╦═══════╦═══════════╣\n");
    printf("║  Pág.  ║ Marco  ║Presente ║ Dirty ║ Ref.      ║\n");
    printf("╠════════╬════════╬═════════╬═══════╬═══════════╣\n");

    for (i = 0; i < NUM_PAGES; i++) {
        if (page_table[i].present || page_table[i].frame_number != -1) {
            printf("║  %3d   ║  %3d   ║   %s     ║   %s   ║   %s       ║\n",
                   i,
                   page_table[i].frame_number,
                   page_table[i].present    ? "✓" : "✗",
                   page_table[i].dirty      ? "✓" : "✗",
                   page_table[i].referenced ? "✓" : "✗");
        }
    }

    printf("╚════════╩════════╩═════════╩═══════╩═══════════╝\n");
}

/* ════════════════════════════════════════════════════════
 * FUNCIÓN: print_stats — Muestra estadísticas finales.
 * ════════════════════════════════════════════════════════*/
void print_stats(void) {
    printf("\n══════ ESTADÍSTICAS ══════\n");
    printf("Accesos totales : %d\n", total_accesses);
    printf("Page faults     : %d (%.1f%%)\n", page_faults,
           total_accesses ? 100.0 * page_faults / total_accesses : 0.0);
    printf("TLB hits        : %d (%.1f%%)\n", tlb_hits,
           total_accesses ? 100.0 * tlb_hits / total_accesses : 0.0);
}

